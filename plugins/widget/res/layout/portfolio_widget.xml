<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background">
    <ImageView android:layout_width="136dp" android:layout_height="136dp" android:layout_gravity="top|end"
        android:src="@drawable/widget_rings" android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:includeFontPadding="false" android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_value_label" android:textColor="@color/widget_muted" android:textSize="12sp" android:letterSpacing="0.1" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/widget_brand" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="@string/widget_brand" android:textColor="@color/widget_accent" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <TextView android:includeFontPadding="false" android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/widget_setup" android:textColor="@color/widget_foreground" android:textSize="32sp"
            android:textStyle="bold" android:letterSpacing="-0.025" android:fontFeatureSettings="tnum" />
        <TextView android:includeFontPadding="false" android:id="@+id/widget_pnl" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/widget_pnl_background" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:textColor="@color/widget_muted" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" />
        <TextView android:includeFontPadding="false" android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
        <TextView android:includeFontPadding="false" android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
